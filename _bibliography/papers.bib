@article{gim2024regularization,
  abbr      = {IEEE Access},
  title     = {Regularization Using Noise Samples Identified by the Feature Norm for Face Recognition},
  author    = {Gim, Taeseong and Sohn, Kyung-Ah},
  journal   = {IEEE Access},
  volume    = {12},
  pages     = {123267--123275},
  year      = {2024},
  publisher = {IEEE},
  doi       = {10.1109/ACCESS.2024.3453030},
  url       = {https://ieeexplore.ieee.org/document/10662963/},
  issn      = {2169-3536},
  abstract  = {Long-Tail 분포를 가진 얼굴인식 데이터셋을 분석해, 클래스별 샘플 수가 많을수록 평균 Feature Norm이 커지는 현상을 발견하고 Feature Norm이 이미지 품질뿐 아니라 클래스별 샘플 수에도 영향받을 수 있음을 제시했습니다. 이를 바탕으로 Feature Norm은 높지만 모델이 제대로 구별하지 못하는 샘플을 노이즈 후보로 정의하고, 해당 샘플을 임베딩 공간에서 다른 데이터와 분리하는 정규화 항을 얼굴인식 Loss에 추가했습니다. 제안한 방법은 TinyFace에서 Rank-1 성능을 1.1%, SurvFace에서 FAR 0.01 기준 TPR을 3% 향상시켰습니다.},
  selected  = {true}
}
